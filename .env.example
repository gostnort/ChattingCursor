BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=4321
BRIDGE_PUBLIC_URL=http://127.0.0.1:4321
BRIDGE_CORS_ORIGINS=http://127.0.0.1:43210,http://localhost:43210,https://*.github.io
# 留空则使用 %USERPROFILE%\.chattingcursor（与历史目录同级）；也可在 Web 配置页持久化
CHATTINGCURSOR_TOKEN_SYNC_DIR=
CHATTINGCURSOR_TOKEN_FILE_NAME=chattingcursor-token.txt
# native=Windows 本机 cursor-agent；wsl=经 WSL。run.bat / run-all.ps1 默认 native
CURSOR_CLI_MODE=native
