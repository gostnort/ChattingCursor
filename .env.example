BRIDGE_HOST=127.0.0.1

BRIDGE_PORT=4321

BRIDGE_PUBLIC_URL=http://127.0.0.1:4321

BRIDGE_CORS_ORIGINS=http://127.0.0.1:*,http://localhost:*,https://*.github.io

# 留空则使用用户主目录下的 .chattingcursor（Windows: %USERPROFILE%\.chattingcursor；Linux/macOS: ~/.chattingcursor）；也可在 Web 配置页持久化

CHATTINGCURSOR_TOKEN_SYNC_DIR=

CHATTINGCURSOR_TOKEN_FILE_NAME=chattingcursor-token.txt

# native=本机 cursor-agent；wsl=仅 Windows 经 WSL。run.bat / run.sh 未设置时会自动探测

CURSOR_CLI_MODE=native

# local_llm：GGUF 权重与 registry 默认 {repoRoot}/local_llm/（pip install -r local_llm/server/requirements-inference.txt）
# CHATTINGCURSOR_LOCAL_LLM_DIR=
# LOCAL_LLM_MANAGED=1
# LOCAL_LLM_PORT=4322
# LOCAL_LLM_HOST=127.0.0.1
# LOCAL_LLM_N_CTX=8192
# 12 GB 显存（如 RTX 4070）跑 26B 时建议 35；留空则 sidecar 按 GGUF 体积自动选择
# -1 = 尽量全部层上 GPU（仅小模型）；0 = 纯 CPU
# LOCAL_LLM_N_GPU_LAYERS=35
# LOCAL_LLM_LOAD_TIMEOUT_MS=600000
# LOCAL_LLM_MAX_NEW_TOKENS=1024
# LOCAL_LLM_AUTO_START_ON_BRIDGE=0
# LOCAL_LLM_STARTUP_TIMEOUT_MS=600000
# LOCAL_LLM_PYTHON=
# LOCAL_LLM_SERVER_SCRIPT=
# 高级：自备推理服务时设 LOCAL_LLM_MANAGED=0 并指定 LOCAL_LLM_API_BASE_URL
# LOCAL_LLM_API_BASE_URL=http://127.0.0.1:4322/v1
# 兼容旧变量名：GEMMA4_* 仍可用
# HF_TOKEN=
# 可选云端回退（需网络）：
# LOCAL_LLM_USE_HF_INFERENCE=1
# LOCAL_LLM_HF_INFERENCE_FALLBACK=1
# LOCAL_LLM_HF_INFERENCE_URL=https://router.huggingface.co/v1/chat/completions
