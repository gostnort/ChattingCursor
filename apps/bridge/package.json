{
  "name": "@chatting-cursor/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @chatting-cursor/cli-client build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && tsx --test src/services/*.test.ts"
  },
  "dependencies": {
    "@chatting-cursor/cli-client": "workspace:*",
    "@chatting-cursor/shared": "workspace:*",
    "@cursor/sdk": "^1.0.14",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "fastify": "^5.2.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
