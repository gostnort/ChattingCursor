{
  "name": "chatting-cursor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:bridge": "pnpm --filter @chatting-cursor/bridge dev",
    "dev:web": "pnpm --filter @chatting-cursor/web dev",
    "dev": "pnpm -r --parallel --filter @chatting-cursor/bridge --filter @chatting-cursor/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @chatting-cursor/shared build && pnpm -r typecheck",
    "test:bridge": "pnpm --filter @chatting-cursor/cli-client build && pnpm --filter @chatting-cursor/bridge exec tsx --test ../../apps/bridge/src/services/web-search-intent.test.ts ../../apps/bridge/src/services/chat-send-cli-gate.test.ts ../../apps/bridge/src/services/chrome-google-search.encode.test.ts ../../apps/bridge/src/services/google-serp-parse.test.ts",
    "cli:watch": "node scripts/cli-watch.mjs",
    "quality:watch": "node scripts/quality-watch.mjs",
    "crew:setup": "python -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt",
    "crew:status": ".venv\\Scripts\\python scripts/run-crew.py --status",
    "crew:run": ".venv\\Scripts\\python scripts/run-crew.py --config configs/crews/example.yaml --inputs-file configs/crews/example-inputs.json --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
